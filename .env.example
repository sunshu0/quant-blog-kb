# 复制为 .env 后填写；.env 不提交
DEEPL_API_KEY=
# 微软 Azure AI Translator（--translator azure）：门户里 Translator 资源的「密钥和终结点」
AZURE_TRANSLATOR_KEY=
# 资源的位置/区域（如 eastasia）；资源是全局（Global）的可以不填
AZURE_TRANSLATOR_REGION=
# 可选：默认全局终结点；自定义域名写成 https://<名字>.cognitiveservices.azure.com/translator/text/v3.0
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# 可选：限速，每分钟最多送多少字符（F0 每小时 200 万，要均匀用；默认 30000）
# AZURE_TRANSLATOR_CHARS_PER_MINUTE=30000
LLM_API_KEY=
# 可选：OpenAI 兼容接口的地址和模型（默认见 config/filters.yaml 的 l2，DeepSeek）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
